{
  "name": "dsh-provider-commandcode",
  "version": "0.1.0",
  "description": "Command Code (commandcode.ai) provider plugin for DeepSeek Harness: Claude on Messages, every other model on Chat Completions, with live model discovery and zero-config reuse of the command-code CLI sign-in",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "commandcode",
    "command-code",
    "llm-provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdlsj/dsh-provider-commandcode.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.1"
  }
}
